# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Pansy: raw Figma exports (300+ MB originals) and source font files.
# Optimized copies go to public/images in Phase 2.
/_incoming/
/.venv/

# Display font (October Compressed H+L Heavy, Typotheque): web licence unconfirmed, so the
# file is kept on this machine only and never committed (decision 2026-11-11). The originals
# are in _incoming/fonts/. The build does not use it (see src/app/fonts.ts).
/src/app/fonts/*.woff2
